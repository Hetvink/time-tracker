# Time Trak configuration — copy to `.env` and fill in.
# Only PUBLIC values belong here: this file is bundled into the apps.
# Never put the Supabase service_role key or e-mail API keys in it
# (those go in Supabase → Edge Functions → Secrets).

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...). Projects with legacy keys can set
# SUPABASE_ANON_KEY instead.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY

# Public URL of the deployed web portal (used in invitation links and the
# desktop "Web Portal" button). Must also be listed in Supabase → Auth →
# URL Configuration → Redirect URLs.
WEB_APP_URL=https://your-web-app.example.com

# Optional: page where members download the desktop tracker
DESKTOP_DOWNLOAD_URL=

# Optional: localhost port for the desktop Google sign-in callback (default 3000).
# Add http://localhost:<port> to Supabase → Auth → Redirect URLs.
OAUTH_CALLBACK_PORT=3000
Platform Admin: admin@test.com (password: password123)
Company Admin: company@test.com (password: password123)
Member: member@test.com (password: password123)