{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Time Trak (desktop)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=.env"]
    },
    {
      "name": "Time Trak (web)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_web.dart",
      "deviceId": "chrome",
      "args": ["--dart-define-from-file=.env", "--web-port=8080"]
    }
  ]
}
